    {
      "id": 13,
      "type": "table",
      "title": "GPUs reporting an Xid",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "DCGM_FI_DEV_XID_ERRORS{region=~\"$region\",datacenter=~\"$datacenter\",node=~\"$node\"} > 0",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "DCGM_FI_DRIVER_VERSION": true,
              "device": true,
              "pci_bus_id": true,
              "Hostname": true,
              "container": true
