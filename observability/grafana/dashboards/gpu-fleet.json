{
  "uid": "gpu-fleet",
  "title": "GPU fleet overview",
  "description": "Metrics and logs of the simulated multi-region NVIDIA GPU fleet.",
  "tags": [
    "gpu",
    "nvidia",
    "dcgm",
    "victoriametrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL, region)",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL, region)",
          "refId": "var"
        }
      },
      {
        "name": "datacenter",
        "label": "Datacenter",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL{region=~\"$region\"}, datacenter)",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{region=~\"$region\"}, datacenter)",
          "refId": "var"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL{region=~\"$region\",datacenter=~\"$datacenter\"}, node)",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{region=~\"$region\",datacenter=~\"$datacenter\"}, node)",
          "refId": "var"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPUs reporting",
      "description": "Series currently exported by the simulated dcgm-exporters.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "count(DCGM_FI_DEV_GPU_UTIL{region=~\"$region\",datacenter=~\"$datacenter\",node=~\"$node\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
