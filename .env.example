# Copy to .env (`make compose-env` does this) and adjust. .env is git-ignored.

# Image name/tag produced by `make compose-build`
GRAFANA_IMAGE=kekaflow/grafana
GRAFANA_TAG=dev

# Host port Grafana is published on
GRAFANA_PORT=3000

# Initial admin credentials. Change the password for anything beyond local use.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Target platform. The frontend builder is pinned to amd64 by the Dockerfile,
# so on Apple Silicon this runs under emulation (slow first build).
PLATFORM=linux/amd64
JS_PLATFORM=linux/amd64
