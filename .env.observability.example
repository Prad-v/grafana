
# --- Observability stack: VictoriaMetrics, VictoriaLogs, GPU simulator, mcp-grafana ---
# (appended to .env by `make obs-env`; every value has a default, so all optional)

# Address the host ports are published on. These services have no authentication
# (and mcp-grafana holds Grafana credentials), so keep the default of 127.0.0.1.
OBS_BIND_ADDRESS=127.0.0.1

# Image tags and the host ports the services are published on
VICTORIAMETRICS_TAG=v1.156.0
VICTORIAMETRICS_PORT=8428
VICTORIALOGS_TAG=v1.54.0
VICTORIALOGS_PORT=9428
OBS_RETENTION=7d

# GPU simulator: UI/API/metrics port and the size of the simulated fleet.
# Total GPUs = 6 regions x 2 datacenters x NODES_PER_DC x GPUS_PER_NODE.
GPU_SIM_PORT=8090
GPU_SIM_NODES_PER_DC=4
GPU_SIM_GPUS_PER_NODE=8
GPU_SIM_TICK_SECONDS=5
GPU_SIM_LOG_RATE=0.2
# Set a number to make the simulation repeatable
GPU_SIM_SEED=

# mcp-grafana: port and credentials. With no token it signs in as the Grafana
# admin from this file; set a service account token to use that instead.
MCP_GRAFANA_TAG=2.3.0-alpine
MCP_GRAFANA_PORT=8000
MCP_GRAFANA_TOKEN=
