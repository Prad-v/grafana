
# --- Chat assistant: Google ADK + Claude agent and the Grafana chat page ---
# (appended to .env by `make chat-env`, which also generates CHAT_AGENT_TOKEN)

# Shared secret between Grafana's plugin proxy and the agent. Generated for you;
# change it by editing here and running `make stack-up` again.
CHAT_AGENT_TOKEN=

# Claude API key. Without it the page loads but every question answers with
# "no API key configured".
ANTHROPIC_API_KEY=

# Any model LiteLLM can reach with the key above.
CHAT_AGENT_MODEL=anthropic/claude-sonnet-5-5

# Host port for the agent (debugging only; Grafana uses the compose network).
CHAT_AGENT_PORT=8081

# Let the agent call tools that change Grafana (create dashboards, silences, ...).
# Off by default: the assistant only reads.
CHAT_AGENT_ALLOW_WRITES=false

# Extra guidance appended to the system prompt, e.g. naming conventions.
CHAT_AGENT_EXTRA_INSTRUCTION=

# Hosts that a LiteLLM proxy address on the assistant's settings page may point at,
# comma separated. A host name matches any port; `host:port` matches that port only.
# Organization admins choose the address, so only list hosts you trust the agent to call.
# Add your proxy here, for example: api.anthropic.com,litellm,litellm.internal:4000
CHAT_AGENT_ALLOWED_LLM_HOSTS=api.anthropic.com,litellm,fake-llm

# Optional: pick the model for the whole chat page at start-up instead of on the
# plugin's Settings page. Grafana re-applies its provisioning file on every start, so
# a choice made on the Settings page is lost on restart unless it is also set here.
# CHAT_LLM_PROVIDER is empty (agent default), anthropic or litellm.
CHAT_LLM_PROVIDER=
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=
CHAT_LLM_API_KEY=
