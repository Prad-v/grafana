{
  "realm": "kekaflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    { "name": "tenant-a-admins" },
    { "name": "tenant-a-users" },
    { "name": "tenant-a-ops" },
    { "name": "tenant-a-dev" },
    { "name": "tenant-b-users" },
    { "name": "tenant-b-ops" },
    { "name": "platform-admins" }
  ],
  "clients": [
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${GRAFANA_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:${GRAFANA_PORT}/*"],
      "webOrigins": ["http://localhost:${GRAFANA_PORT}"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@tenant-a.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": ["/tenant-a-admins", "/tenant-a-ops"]
    },
    {
      "username": "bob",
      "email": "bob@tenant-a.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": ["/tenant-a-users", "/tenant-a-dev"]
    },
    {
      "username": "carol",
      "email": "carol@tenant-b.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": ["/tenant-b-users", "/tenant-b-ops"]
    },
    {
      "username": "dave",
      "email": "dave@shared.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dave",
      "lastName": "Shared",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": ["/tenant-a-users", "/tenant-b-users", "/tenant-b-ops"]
    },
    {
      "username": "erin",
      "email": "erin@platform.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Erin",
      "lastName": "Platform",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": ["/platform-admins"]
    },
    {
      "username": "frank",
      "email": "frank@nogroups.example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Frank",
      "lastName": "Nogroups",
      "credentials": [{ "type": "password", "value": "${SSO_TEST_PASSWORD}", "temporary": false }],
      "groups": []
    }
  ]
}
