
# --- Keycloak SSO demo (appended to .env by `make sso-env`) ---

# Keycloak image tag and the host port it is published on
KEYCLOAK_TAG=26.4.0
KEYCLOAK_PORT=8080

# Keycloak master realm admin. Change the password for anything beyond local use.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secret of the `grafana` OIDC client and password of every demo user
GRAFANA_CLIENT_SECRET=grafana-local-client-secret
SSO_TEST_PASSWORD=ChangeMe-sso-demo
